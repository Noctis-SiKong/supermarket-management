# Java build output (root-scoped; keep report evidence and intentional samples)
/target/
/build/
/.gradle/
/*.class
/*.jar
/*.war
/*.nar
/*.ear
/hs_err_pid*.log
/replay_pid*.log

# Defensive guards for accidental runtime output in the repository.
# DATA_ROOT is repository-root data/; these patterns guard runtime output.
/data/
/runtime/
/attachments/
/logs/
/tmp/
/backups/
/.local/
/.codex/
/.env
/.env.*
!/.env.example
/local-settings.properties

