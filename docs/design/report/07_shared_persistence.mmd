classDiagram
direction TB

class SubmissionPort {
    +open(op) Result~WorkingCopy~
    +submit(op, request, wc, changes) Result~CommitReceipt~
    +lookupResult(op, request) Result~CommitReceipt~
}
class CommitValidator {
    +validate(op, actor, request, wc, changes, acceptedAt) Result~Void~
}
class AbstractReconstructingCommitValidator {
    +validate(...) Result~Void~
    #reconstruct(...) Result~ChangeSet~
    #mismatch() Result~Void~
}
class StockOperationValidator
class ReversalCommitValidator
class JsonStore
class WorkingCopy {
    +baseLast() long
    +records(table) List
    +find(table, id) Optional
    +overlay(changes) WorkingCopy
}
class ChangeSet {
    +inserts() List
    +patches() List
    +removals() List
}
class SubmissionTime {
    +assign(baseline, changes, acceptedAt) ChangeSet
}

SubmissionPort <|.. JsonStore
CommitValidator <|.. AbstractReconstructingCommitValidator
AbstractReconstructingCommitValidator <|-- StockOperationValidator
AbstractReconstructingCommitValidator <|-- ReversalCommitValidator
AbstractReconstructingCommitValidator ..> SubmissionTime
JsonStore ..> WorkingCopy
WorkingCopy ..> ChangeSet
SubmissionTime ..> ChangeSet
