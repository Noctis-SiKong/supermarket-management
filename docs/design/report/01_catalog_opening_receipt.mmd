classDiagram
direction TB

namespace catalog {
    class Product {
        +String barcode
        +String name
        +String unit
        +BigDecimal sellingPrice
    }
}

namespace receipt {
    class AOperations
    class AttachmentStore
    class DocumentHeader {
        +String documentId
        +String kind
        +String status
        +String confirmedBy
        +String confirmedAt
    }
    class DocumentLine {
        +String lineId
        +String documentId
        +String barcode
        +int quantity
    }
}

namespace contracts {
    class SubmissionPort
}

namespace infrastructure {
    class JsonStore
}

AOperations ..> Product : price
AOperations ..> AttachmentStore : verify
AOperations ..> DocumentHeader
AOperations ..> DocumentLine
AOperations ..> SubmissionPort : prepare / submit
SubmissionPort <|.. JsonStore
